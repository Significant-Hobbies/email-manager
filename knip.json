{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/agent-edge.mjs", "scripts/**/*.mjs"],
      "project": [
        "src/**/*.{ts,tsx,mjs,css}",
        "scripts/**/*.mjs",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": ["lightningcss"]
    },
    "landing-astro": {
      "entry": ["public/project-strip.js"],
      "ignoreDependencies": ["lightningcss", "wrangler"]
    }
  }
}
