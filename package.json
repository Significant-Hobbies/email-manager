{
  "name": "email-manager",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,spa -c blue,green \"pnpm dev:api\" \"pnpm dev:spa\"",
    "predev": "node scripts/ensure-landing.mjs",
    "predev:spa": "node scripts/ensure-landing.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev:api": "wrangler dev --port 8787",
    "dev:spa": "vite",
    "build:landing": "pnpm --filter ./landing-astro build",
    "build": "vite build && pnpm build:landing && node scripts/overlay-landing.mjs && pnpm verify:indexing",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "biome lint .",
    "digest:verify": "pnpm dlx tsx scripts/verify-digest-fixture.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "deploy": "pnpm build && wrangler deploy --tag \"$(git rev-parse HEAD)\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:indexing": "node scripts/verify-public-indexing.mjs",
    "foundry:evidence": "node scripts/foundry-evidence.mjs",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols",
    "quality:unused": "pnpm run knip:strict",
    "quality:complexity": "node scripts/check-code-health.mjs complexity",
    "quality:duplication": "jscpd src scripts --format javascript,typescript --min-lines 8 --min-tokens 60 --mode strict --ignore '**/*.test.*,**/*.spec.*,**/node_modules/**,**/coverage/**,**/dist/**' --threshold 0 --silent --no-tips",
    "quality:cycles": "knip --cycles",
    "quality:dependencies": "node scripts/check-code-health.mjs dependencies",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run quality:unused && pnpm run quality:complexity && pnpm run quality:duplication && pnpm run quality:cycles && pnpm run quality:dependencies"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.42.2",
    "hono": "4.12.32",
    "idb": "8.0.3",
    "lucide-react": "^1.27.0",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "4.20260424.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@vitejs/plugin-react-swc": "4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "9.2.1",
    "jscpd": "5.0.14",
    "knip": "^6.29.0",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "ultracite": "7.10.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.0": "0.6.0",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.9",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.5",
      "ip-address@>=10.0.0 <11.0.0": "10.3.1",
      "js-yaml@>=3.0.0 <4.0.0": "3.15.1",
      "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
      "nanoid@>=3.0.0 <4.0.0": "3.3.18",
      "next@>=16.0.0 <17.0.0": "16.2.11",
      "path-to-regexp@>=6.0.0 <7.0.0": "6.3.0",
      "postcss@>=8.0.0 <9.0.0": "8.5.23",
      "sharp@>=0.34.0 <0.35.0": "0.35.0",
      "shell-quote": "1.9.0",
      "svgo@>=4.0.0 <5.0.0": "4.0.2",
      "tar@<=7.5.20": "7.5.21",
      "undici@>=7.0.0 <8.0.0": "7.29.0",
      "undici@>=8.0.0 <9.0.0": "8.9.0"
    }
  }
}
