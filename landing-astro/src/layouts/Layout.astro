---
import '@/styles/landing.css';

interface Props {
  /** This route renders its own declarative product footer. */
  hasProductFooter?: boolean;
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const SITE_URL = 'https://mail.significanthobbies.com';
const canonicalPath = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname.replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, `${SITE_URL}/`).href;
// OG image lives on the Next.js Worker at /opengraph-image (file
// convention → dynamic JSX → PNG). Astro can't trivially reproduce
// that. The Worker still serves every non-`/` route so this URL
// resolves after the static landing takes over `/`.
const OG_IMAGE = `${SITE_URL}/opengraph-image`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Kinetic',
      url: SITE_URL,
      description,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Kinetic',
      alternateName: 'Email Manager',
      applicationCategory: 'ProductivityApplication',
      operatingSystem: 'Web',
      url: SITE_URL,
      image: OG_IMAGE,
      description,
      sameAs: ['https://github.com/Significant-Hobbies/email-manager'],
    },
  ],
};
const hasProductFooter = Astro.props.hasProductFooter === true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Kinetic" />
    <meta name="theme-color" content="#fbf8ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1b22" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Kinetic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta name="keywords" content="Gmail triage, email filters, inbox cleanup, semantic email search, IndexedDB email" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","y6bt70yq9x");
      window.clarity("set","project_id","email-manager");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" /></noscript>
    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_37f68db75b5fa443187ef0be60cb69608b24b9aa44bb5c7bc23668e6e99f03b3"
      data-project="app-import-8defb952e4519d85bccde5f102a72950f9d788bae692feb4e6c75ee053623664"
      data-identity="persistent"
    ></script>
  </head>
  <body>
    <slot />
    {!hasProductFooter && <fleet-footer-extension
    product-name="Kinetic"
    art-src="https://sassmaker.com/footer-art/email-manager.webp"
    class="precise-footer"
    signature-name="Kinetic"
    font-base="https://sassmaker.com/fonts/fleet-footer-precise-v1/"
    theme="light"
    surface="app"
    art-alt="Kinetic: A deliberate inbox sorting desk centers one selected sealed envelope and a hand-operated review tray. Different sender-sized envelope groups occupy the wings; no sender identity or message content is visible."
    art-width="2169"
    art-height="725"
    art-position="50% 50%"
    art-credit="Original illustration for Kinetic"
  ></fleet-footer-extension>}
    <script is:inline type="module" src="https://sassmaker.com/newsletter-capture.js"></script>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[data-log]') : null;
        const name = link?.getAttribute('data-log');
        const tracker = window.appHealth;
        if (!name?.startsWith('kinetic.cta.') || !tracker) return;

        tracker.track(name);

        const destination = link instanceof HTMLAnchorElement ? new URL(link.href) : null;
        const plainAppNavigation =
          destination?.origin === location.origin &&
          destination.pathname === '/app' &&
          event.button === 0 &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.shiftKey &&
          !event.altKey &&
          link?.target !== '_blank';
        if (!plainAppNavigation) return;

        event.preventDefault();
        void tracker.flush().finally(() => location.assign(destination.href));
      }, { capture: true });
    </script>
    <script is:inline src="https://sassmaker.com/project-strip.js" data-project="email-manager" defer data-theme="light"
      data-host-only="true"
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="Kinetic"
      defer
      data-theme="light"
      data-host-only="true"
      data-project="email-manager"
    ></script>
  </body>
</html>
