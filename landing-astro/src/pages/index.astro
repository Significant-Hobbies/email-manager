---
import Base from '@saas-maker/templates/Base.astro';
import { WorkbenchPage } from '@saas-maker/templates/workbench-page';
import { baseProps } from '@saas-maker/templates/page';
import { workbenchContent } from '@saas-maker/templates/schema';
import json from '../content/home.json';

const content = workbenchContent.parse(json);
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta name="application-name" content="Kinetic" />
    <meta name="theme-color" content="#fbf8ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1b22" media="(prefers-color-scheme: dark)" />

    <meta name="keywords" content="Gmail triage, email filters, inbox cleanup, semantic email search, IndexedDB email" />
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","y6bt70yq9x");
      window.clarity("set","project_id","email-manager");
    </script>

    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_37f68db75b5fa443187ef0be60cb69608b24b9aa44bb5c7bc23668e6e99f03b3"
      data-project="app-import-8defb952e4519d85bccde5f102a72950f9d788bae692feb4e6c75ee053623664"
      data-identity="persistent"
      data-vitals
    ></script>
    <!-- Template links do not accept data-log; delegate the existing CTA events by href and region. -->
    <script is:inline>
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href="/app"]') : null;
        const name = link?.closest('header')
          ? 'kinetic.cta.nav_open_app'
          : link?.closest('main')
            ? link.closest('section')?.querySelector('h1')
              ? 'kinetic.cta.hero_connect_gmail'
              : 'kinetic.cta.closing_connect_gmail'
            : null;
        if (name) window.appHealthLog?.(name, { title: link.textContent?.trim(), props: { page: location.pathname } });
        const tracker = window.appHealth;
        if (!name?.startsWith('kinetic.cta.') || !tracker) return;

        tracker.track(name);

        const destination = link instanceof HTMLAnchorElement ? new URL(link.href) : null;
        const plainAppNavigation =
          destination?.origin === location.origin &&
          destination.pathname === '/app' &&
          event.button === 0 &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.shiftKey &&
          !event.altKey &&
          link?.target !== '_blank';
        if (!plainAppNavigation) return;

        event.preventDefault();
        void tracker.flush().finally(() => location.assign(destination.href));
      }, { capture: true });
    </script>
  </Fragment>
  <WorkbenchPage content={content} />
</Base>
